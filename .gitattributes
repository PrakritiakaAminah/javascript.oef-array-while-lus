/* Studentenlijst
Start met een lege array. Schrijf code om deze array op te vullen met namen. 
Blijf dit herhalen tot je de waarde 'S' meegeeft om te stoppen. 
Druk vervolgens je namenlijst af.*/


import * as readline from 'node:readline/promises';
import{stdin as input, stdout as output} from 'node:process';
const userInput = readline.createInterface({input, output});

let namen =[];

let naam = await userInput.question('Geef een naam (S om te stoppen):');

//naam.match('S[a-zA-Z]*') regex101
while (naam !== 'S'){
    namen.push(naam);
    naam = await userInput.question('Geef een naam (S om te stoppen):');
}

console.log('Namenlijst:');


for (let i = 0; i < namen.length; i++){
    console.log(namen[i]);
}
process.exit();


